# Optional: leer lassen für die sichere Ersteinrichtung im Browser.
VORRIO_VERSION=0.8.24
APP_PASSWORD=
# Vor dem Start setzen: openssl rand -hex 32
APP_SECRET_KEY=
DEPLOYMENT_PROFILE=lan
PUBLIC_URL=
TRUSTED_HOSTS=*
ALLOWED_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_HTTPS_ONLY=false
# Nur nach erfolgreicher Prüfung des vollständigen Public-HTTPS-Vertrags aktivieren.
PUBLIC_EXPOSURE_ACKNOWLEDGED=false
MAX_UPLOAD_MB=12
MAX_REQUEST_MB=13
MAX_IMAGE_MEGAPIXELS=40
RECEIPT_RETENTION_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
WEB_PUSH_SUBJECT=mailto:admin@vorrio.local
NOTIFICATION_CHECK_SECONDS=900
# Optionaler Bind-Host für den veröffentlichten Container-Port. Bei einem
# lokalen Host-Reverse-Proxy für Public HTTPS auf 127.0.0.1 setzen.
PUBLISHED_ADDRESS=0.0.0.0
VORRIO_DATA_VOLUME=vorrio_data
TZ=Europe/Berlin

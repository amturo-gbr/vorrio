{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/AI-PROVIDERS", "destination": "/en/AI-PROVIDERS", "permanent": true },
    { "source": "/API", "destination": "/en/API", "permanent": true },
    { "source": "/AUTOMATION-TOKENS", "destination": "/en/AUTOMATION-TOKENS", "permanent": true },
    { "source": "/BACKUP-RESTORE", "destination": "/en/BACKUP-RESTORE", "permanent": true },
    { "source": "/BARCODE-SCANNING", "destination": "/en/BARCODE-SCANNING", "permanent": true },
    { "source": "/BUDGET", "destination": "/en/BUDGET", "permanent": true },
    { "source": "/CONFIGURATION", "destination": "/en/CONFIGURATION", "permanent": true },
    { "source": "/DATA-MODEL", "destination": "/en/DATA-MODEL", "permanent": true },
    { "source": "/DATA-PRIVACY", "destination": "/en/DATA-PRIVACY", "permanent": true },
    { "source": "/DATA-SOURCES", "destination": "/en/DATA-SOURCES", "permanent": true },
    { "source": "/DEPLOYMENT-PROFILES", "destination": "/en/DEPLOYMENT-PROFILES", "permanent": true },
    { "source": "/EXTERNAL-ACCESS-SECURITY-REVIEW", "destination": "/en/EXTERNAL-ACCESS-SECURITY-REVIEW", "permanent": true },
    { "source": "/FOUNDATION-CHECKLIST", "destination": "/en/FOUNDATION-CHECKLIST", "permanent": true },
    { "source": "/FUNDING", "destination": "/en/FUNDING", "permanent": true },
    { "source": "/GETTING-STARTED", "destination": "/en/GETTING-STARTED", "permanent": true },
    { "source": "/GOVERNANCE", "destination": "/en/GOVERNANCE", "permanent": true },
    { "source": "/IDENTITY-SECURITY", "destination": "/en/IDENTITY-SECURITY", "permanent": true },
    { "source": "/INSTALLATION", "destination": "/en/INSTALLATION", "permanent": true },
    { "source": "/LOCALIZATION", "destination": "/en/LOCALIZATION", "permanent": true },
    { "source": "/MIGRATION-GROCY", "destination": "/en/MIGRATION-GROCY", "permanent": true },
    { "source": "/MOBILE-APPS", "destination": "/en/MOBILE-APPS", "permanent": true },
    { "source": "/NOTIFICATIONS", "destination": "/en/NOTIFICATIONS", "permanent": true },
    { "source": "/PUBLIC-LAUNCH-CHECKLIST", "destination": "/en/PUBLIC-LAUNCH-CHECKLIST", "permanent": true },
    { "source": "/RELEASES", "destination": "/en/RELEASES", "permanent": true },
    { "source": "/ROADMAP", "destination": "/en/ROADMAP", "permanent": true },
    { "source": "/STRIPE-SUPPORT", "destination": "/en/STRIPE-SUPPORT", "permanent": true },
    { "source": "/TRANSLATION-COMMUNITY", "destination": "/en/TRANSLATION-COMMUNITY", "permanent": true },
    { "source": "/WORKFLOW", "destination": "/en/WORKFLOW", "permanent": true },
    { "source": "/api-reference", "destination": "/en/api-reference", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}

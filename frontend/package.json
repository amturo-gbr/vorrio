{
  "name": "vorrio-web",
  "private": true,
  "version": "0.8.22",
  "description": "Responsive self-hosted household inventory and shopping PWA",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/amturo-gbr/vorrio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amturo-gbr/vorrio.git"
  },
  "bugs": {
    "url": "https://github.com/amturo-gbr/vorrio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run bundle:check",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts && npm run i18n:check",
    "i18n:check": "node scripts/check-i18n-contract.mjs",
    "bundle:check": "node scripts/check-bundle-contract.mjs",
    "test:offline": "node --experimental-strip-types --test tests/offlineQueue.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@zxing/browser": "^0.2.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
